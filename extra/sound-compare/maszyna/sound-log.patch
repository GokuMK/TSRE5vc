+// sound log (EU07_SOUND_CSV): writes a csv row for each playing source
+// t,key,file,x,y,z,gain,pitch,soundproofing,distance,final
+void
+openal_renderer::log_sources( std::ostream &Output, int const Time ) const {
+
+    auto const csvtext { []( std::string Text ) {
+        std::replace( std::begin( Text ), std::end( Text ), ',', ';' );
+        return Text; } };
+
+    ALfloat listener[ 3 ] { 0.f, 0.f, 0.f };
+    ::alGetListenerfv( AL_POSITION, listener );
+
+    for( auto const &source : m_sources ) {
+
+        if( source.id == audio::null_resource
+         || source.controller == nullptr
+         || source.sounds.empty() ) {
+            continue;
+        }
+        ALint state;
+        ::alGetSourcei( source.id, AL_SOURCE_STATE, &state );
+        if( state != AL_PLAYING ) { continue; }
+
+        auto const &controller { *source.controller };
+        auto const sound { source.sounds[ std::min<std::size_t>( source.sound_index, source.sounds.size() - 1 ) ] };
+
+        auto key { controller.label() };
+        if( key.empty() && controller.owner() == nullptr && false == controller.name().empty() ) {
+            key = "scenery:" + controller.name();
+        }
+        // what the source has in OpenAL now
+        ALfloat gain, pitch, reference, rolloff, maxdistance;
+        ALfloat position[ 3 ];
+        ALint relative;
+        ::alGetSourcef( source.id, AL_GAIN, &gain );
+        ::alGetSourcef( source.id, AL_PITCH, &pitch );
+        ::alGetSourcef( source.id, AL_REFERENCE_DISTANCE, &reference );
+        ::alGetSourcef( source.id, AL_ROLLOFF_FACTOR, &rolloff );
+        ::alGetSourcef( source.id, AL_MAX_DISTANCE, &maxdistance );
+        ::alGetSourcefv( source.id, AL_POSITION, position );
+        ::alGetSourcei( source.id, AL_SOURCE_RELATIVE, &relative );
+        auto const offset { glm::vec3{ position[ 0 ], position[ 1 ], position[ 2 ] } - ( relative ? glm::vec3{} : glm::vec3{ listener[ 0 ], listener[ 1 ], listener[ 2 ] } ) };
+        // AL_INVERSE_DISTANCE_CLAMPED, the model set in init()
+        auto const distance { std::clamp( glm::length( offset ), reference, std::max( reference, maxdistance ) ) };
+        auto const attenuationdivisor { reference + rolloff * ( distance - reference ) };
+        auto const distancefactor { attenuationdivisor > 0.f ? reference / attenuationdivisor : 1.f };
+        // AL_GAIN holds gain * crossfade * soundproofing * range fade * category volume
+        auto const categoryvolume { (
+            source.properties.category == sound_category::vehicle ? Global.VehicleVolume :
+            source.properties.category == sound_category::local ? Global.EnvironmentPositionalVolume :
+            source.properties.category == sound_category::ambient ? Global.EnvironmentAmbientVolume :
+            1.f ) };
+        auto const finalgain { categoryvolume > 0.f ? gain / categoryvolume * distancefactor : 0.f };
+
+        Output
+            << Time << ','
+            << csvtext( key ) << ','
+            << csvtext( controller.file( sound ) ) << ','
+            << std::fixed << std::setprecision( 2 )
+            << controller.offset().x << ','
+            << controller.offset().y << ','
+            << controller.offset().z << ','
+            << std::setprecision( 4 )
+            << controller.gain() << ','
+            << pitch << ','
+            << source.properties.soundproofing << ','
+            << distancefactor << ','
+            << finalgain << '\n';
+    }
+}
