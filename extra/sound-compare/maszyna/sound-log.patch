+
+// sound log, active when the environment variable EU07_SOUND_CSV names a directory: once per simulated
+// second writes the playing sources to <dir>/sounds.csv and the state of the player's vehicle to <dir>/state.csv
+void
+sound_log_update( double const Deltatime ) {
+
+    if( false == soundlog.checked ) {
+        soundlog.checked = true;
+        auto const *directory { std::getenv( "EU07_SOUND_CSV" ) };
+        if( directory == nullptr || *directory == '\0' ) { return; }
+        soundlog.directory = directory;
+        soundlog.sounds.open( soundlog.directory + "/sounds.csv", std::ios::trunc );
+        soundlog.state.open( soundlog.directory + "/state.csv", std::ios::trunc );
+        soundlog.active = soundlog.sounds.is_open() && soundlog.state.is_open();
+        WriteLog( "sound log: " + ( soundlog.active ? "writing to " + soundlog.directory : "failed to open files in " + soundlog.directory ) );
+    }
+    if( false == soundlog.active ) { return; }
+    if( false == simulation::is_ready || Deltatime <= 0.0 ) { return; }
+
+    auto const *train { simulation::Train };
+    auto const *vehicle { train != nullptr ? train->Dynamic() : nullptr };
+
+    ++soundlog.frames;
+    if( false == soundlog.header ) {
+        soundlog.header = true;
+        soundlog.start = soundlog.lastreport = std::chrono::steady_clock::now();
+        auto const intooutput { std::chrono::duration<double>( soundlog.start - soundlog_deviceopened ).count() };
+        soundlog.sounds
+            << "# MaSzyna (eu07) sound log: source commit 66a940d4 with extra/sound-compare/maszyna/sound-log.patch\n"
+            << "# vehicle: " << ( vehicle != nullptr ? vehicle->name() + ", " + vehicle->asBaseDir + vehicle->MoverParameters->TypeName + ".mmd, cab " + std::to_string( vehicle->MoverParameters->CabOccupied ) : std::string{ "none" } ) << "\n"
+            << "# volumes from eu07.ini, not in 'final': sound.volume (listener gain) " << Global.AudioVolume
+            << ", sound.volume.vehicle " << Global.VehicleVolume
+            << ", sound.volume.positional " << Global.EnvironmentPositionalVolume
+            << ", sound.volume.ambient " << Global.EnvironmentAmbientVolume
+            << ", sound.volume.radio " << Global.DefaultRadioVolume << "\n"
+            << "# x,y,z: offset in the vehicle's frame (x left, y up, z front) or in the region for sounds without vehicle\n"
+            << "# gain: volume set by the vehicle/cab code; pitch: AL_PITCH; distance: OpenAL inverse distance clamped factor (reference range/16*soundproofing, rolloff 1.75)\n"
+            << "# final: gain * table crossfade * soundproofing * fade beyond range * distance; OpenAL clamps final * category volume to AL_MAX_GAIN (1) per source\n"
+            << "# t=0 is " << std::fixed << std::setprecision( 3 ) << intooutput << " s after the audio device opened (the start of a wave writer capture)\n"
+            << "t,key,file,x,y,z,gain,pitch,soundproofing,distance,final\n";
+        soundlog.state
+            << "t,speed_kmh,mc,sc,current_a,motor_rps,converter,compressor,main_switch,battery,panto_front,panto_rear,brake_cyl_bar,pipe_bar,main_res_bar,window,manual_brake,unit_brake_force_n\n";
+    }
+
+    soundlog.time += Deltatime;
+    while( soundlog.time >= soundlog.next ) {
+        auto const time { soundlog.next++ };
+        renderer.log_sources( soundlog.sounds, time );
+        soundlog.sounds.flush();
+        if( time % 10 == 0 ) {
+            auto const now { std::chrono::steady_clock::now() };
+            auto const real { std::chrono::duration<double>( now - soundlog.start ).count() };
+            auto const span { std::chrono::duration<double>( now - soundlog.lastreport ).count() };
+            WriteLog( "sound log: simulated " + std::to_string( soundlog.time ) + " s in " + std::to_string( real ) + " s real time, "
+                + std::to_string( span > 0.0 ? soundlog.frames / span : 0.0 ) + " fps" );
+            soundlog.lastreport = now;
+            soundlog.frames = 0;
+        }
+        if( vehicle != nullptr ) {
+            auto const &mover { *vehicle->MoverParameters };
+            soundlog.state
+                << time << ','
+                << std::fixed << std::setprecision( 2 )
+                << mover.Vel << ','
+                << mover.MainCtrlPos << ','
+                << mover.ScndCtrlPos << ','
+                << std::setprecision( 1 )
+                << mover.Im << ','
+                << std::setprecision( 2 )
+                << mover.enrot << ','
+                << ( mover.ConverterFlag ? 1 : 0 ) << ','
+                << ( mover.CompressorFlag ? 1 : 0 ) << ','
+                << ( mover.Mains ? 1 : 0 ) << ','
+                << ( mover.Battery ? 1 : 0 ) << ','
+                << ( mover.Pantographs[ end::front ].is_active ? 1 : 0 ) << ','
+                << ( mover.Pantographs[ end::rear ].is_active ? 1 : 0 ) << ','
+                << std::setprecision( 3 )
+                // the mover keeps pressures in bar (0.1 MPa)
+                << mover.BrakePress << ','
+                << mover.PipePress << ','
+                << mover.Compressor << ','
+                << ( Global.CabWindowOpen ? 1 : 0 ) << ','
+                // the handbrake's position and the force on a brake shoe (N), any brake's
+                << mover.ManualBrakePos << ','
+                << std::setprecision( 0 ) << mover.UnitBrakeForce << '\n';
+            soundlog.state.flush();
+        }
+    }
+}
