+struct sound_log {
+    bool checked { false };
+    bool active { false };
+    std::string directory;
+    std::ofstream sounds;
+    std::ofstream state;
+    double time { 0.0 }; // simulated seconds since the scenario became ready
+    int next { 1 }; // time of the next sample
+    bool header { false };
+    // pace report in log.txt: frames and real time against simulated time
+    std::chrono::steady_clock::time_point start;
+    std::chrono::steady_clock::time_point lastreport;
+    int frames { 0 };
+};
