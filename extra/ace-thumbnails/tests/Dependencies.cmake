execute_process(COMMAND "${OBJDUMP}" -p "${DLL}" OUTPUT_VARIABLE info RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect DLL imports")
endif()
string(REGEX MATCHALL "DLL Name: [^\r\n]+" imports "${info}")
if(NOT imports)
    message(FATAL_ERROR "DLL import table not found")
endif()
foreach(entry IN LISTS imports)
    string(REPLACE "DLL Name: " "" name "${entry}")
    string(TOLOWER "${name}" name)
    if(NOT name MATCHES "^(advapi32|gdi32|kernel32|msvcrt|shell32|ole32|user32|oleaut32|comdlg32|winspool|ucrtbase)\\.dll$"
       AND NOT name MATCHES "^api-ms-win-.*\\.dll$")
        message(FATAL_ERROR "Unexpected non-system DLL dependency: ${name}")
    endif()
endforeach()
message(STATUS "DLL uses only Windows system imports: ${imports}")
