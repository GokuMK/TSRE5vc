#panel
{
    position: absolute;
    left: 16dp;
    top: 16dp;
    width: 240dp;
    padding: 10dp 16dp 14dp 16dp;
    background-color: #10141cc8;
    border-radius: 8dp;
}

#drag
{
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.label
{
    font-size: 16dp;
    color: #a8b4c8;
}

#speed
{
    font-size: 54dp;
    font-weight: bold;
}

#speedValue.rising { color: #8ee08e; }
#speedValue.falling { color: #ffb347; }

.unit
{
    margin-left: 5dp;
    font-size: 22dp;
    font-weight: normal;
    color: #c8d0dc;
}

#distance
{
    font-size: 27dp;
    margin-bottom: 8dp;
}

.bar
{
    height: 8dp;
    margin: 3dp 0 8dp 0;
    background-color: #ffffff28;
    border-radius: 4dp;
}

.fill
{
    height: 100%;
    border-radius: 4dp;
}

.throttle { background-color: #4caf50; }
.brake { background-color: #e57373; }
