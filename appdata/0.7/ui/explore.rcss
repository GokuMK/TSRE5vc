/* Explore mode's documents (tasks explore 01 and 02). Sizes in dp: the view
   is 1080 of them tall; at 4:3 it is 1440 wide, so everything fits in
   1440 x 1080 and a wider view shows more beside it. */

body.page
{
    pointer-events: none;
}

scrollbarvertical
{
    width: 8dp;
    margin-left: 4dp;
}

scrollbarvertical slidertrack
{
    background-color: #ffffff0c;
}

scrollbarvertical sliderbar
{
    background-color: #ffffff40;
    min-height: 24dp;
}

/* The main menu: large items on the left, the middle of the height. With a
   window open it stays live beside it, as tabs: the window's item marked. */
#items
{
    position: absolute;
    left: 72dp;
    top: 360dp;
    width: 330dp;
}

#items button
{
    display: block;
    font-size: 40dp;
    padding: 6dp 0dp 6dp 22dp;
    margin-bottom: 10dp;
    color: #c8c8c8;
    border-left: 4dp transparent;
    focus: auto;
    nav-left: none;
    nav-right: none;
}

/* Up and Down stay in the menu (the window beside it is not nearer). */
#explore { nav-up: none; nav-down: #exit; }
#exit { nav-up: #explore; nav-down: none; }

#items button.current
{
    color: #ffffff;
    border-left-color: #c4a48099;
}

#items button:focus
{
    color: #ffffff;
    border-left-color: #c4a480;
    background-color: #ffffff14;
}

/* Not built yet: shown, greyed, out of the keys' and the mouse's way. */
#items button.later
{
    color: #6c6c6c;
    tab-index: none;
    nav: none;
    pointer-events: none;
}

#items button .note
{
    font-size: 16dp;
    margin-left: 12dp;
    color: #6c6c6c;
}

#version
{
    position: absolute;
    right: 24dp;
    bottom: 18dp;
    font-size: 16dp;
    color: #808080;
}

/* A window right of the menu, shown with its item (class "shown"). */
.window
{
    display: none;
    position: absolute;
    left: 430dp;
    right: 40dp;
    top: 60dp;
    bottom: 60dp;
    background-color: #0b0d10e6;
    border: 1dp #c4a48066;
    pointer-events: auto;
    font-size: 19dp;
}

.window.shown
{
    display: block;
}

.window h2
{
    font-size: 26dp;
    color: #ffffff;
    height: 38dp;
    overflow: hidden;
    white-space: nowrap;
}

/* The route page (task explore 05): the routes, the chosen route. */
.column
{
    position: absolute;
    top: 24dp;
    bottom: 24dp;
}

#routes-column { left: 2%; width: 24%; }
#route-column { left: 28%; right: 2%; }

.list
{
    position: absolute;
    top: 50dp;
    bottom: 0dp;
    left: 0dp;
    right: 0dp;
    overflow-y: auto;
}

.item
{
    display: block;
    padding: 5dp 10dp;
    color: #c8c8c8;
    border-left: 3dp transparent;
    white-space: nowrap;
    overflow: hidden;
}

.item:hover, .item:focus
{
    color: #ffffff;
    background-color: #ffffff14;
}

.item.chosen
{
    color: #ffffff;
    border-left-color: #c4a480;
    background-color: #c4a48026;
}

.item .note
{
    margin-left: 12dp;
    font-size: 15dp;
    color: #8c8c8c;
}

/* Left from a route goes back to the menu's item. */
#routes .item { nav-left: #explore; }

#route-info
{
    position: absolute;
    top: 50dp;
    bottom: 76dp;
    left: 0dp;
    right: 0dp;
    overflow-y: auto;
}

/* The picture its own shape, as tall as leaves room for the text. */
#route-info img
{
    display: block;
    height: 400dp;
    margin-bottom: 14dp;
}

.facts
{
    color: #e0e0e0;
    margin-bottom: 6dp;
}

.text
{
    color: #b0b0b0;
    white-space: pre-line;
    margin-bottom: 10dp;
}

.text.lead
{
    color: #d0d0d0;
}

.hint
{
    color: #8c8c8c;
    padding: 6dp 10dp;
}

/* The route's pages: greyed when it has none of them. */
.page-buttons
{
    position: absolute;
    left: 0dp;
    right: 0dp;
    bottom: 0dp;
    height: 58dp;
    display: flex;
}

.page-button
{
    display: block;
    flex: 1 1 0dp;
    margin-right: 14dp;
    padding: 12dp 16dp;
    font-size: 22dp;
    text-align: center;
    color: #ffffff;
    background-color: #ffffff0f;
    border: 1dp #c4a48066;
}

.page-button:focus, .page-button:hover
{
    background-color: #c4a48040;
    border-color: #c4a480;
}

.page-button .count
{
    margin-left: 10dp;
    color: #c4a480;
}

.page-button.disabled
{
    color: #6c6c6c;
    background-color: #ffffff06;
    border-color: #ffffff20;
    tab-index: none;
    nav: none;
    pointer-events: none;
}

.page-button.disabled .count
{
    color: #6c6c6c;
}

/* A run's page: its heading, the page, the bar under it. */
.heading
{
    position: absolute;
    left: 2%;
    right: 2%;
    top: 18dp;
    height: 44dp;
    white-space: nowrap;
    overflow: hidden;
}

#back
{
    display: inline-block;
    font-size: 24dp;
    padding: 4dp 12dp;
    color: #c8c8c8;
    border: 1dp transparent;
}

#back:focus, #back:hover
{
    color: #ffffff;
    border-color: #c4a480;
}

.heading .title
{
    font-size: 26dp;
    color: #ffffff;
    margin-left: 18dp;
}

.pagebox
{
    position: absolute;
    left: 2%;
    right: 2%;
    top: 74dp;
    bottom: 136dp;
}

.choice
{
    box-sizing: border-box;
    display: block;
    padding: 6dp 10dp;
    color: #ffffff;
    background-color: #ffffff0a;
    border: 1dp #ffffff20;
    white-space: nowrap;
    overflow: hidden;
}

.choice:hover, .choice:focus
{
    background-color: #ffffff1e;
    border-color: #c4a480;
}

.label
{
    display: inline-block;
    color: #9a9a9a;
}

/* A row of tools over a list: its filter, toggles. */
.tools
{
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: 0dp;
    display: flex;
    align-items: center;
    height: 40dp;
}

.tools button, .tools span
{
    flex: 0 0 auto;
}

.tools .label
{
    margin-right: 8dp;
    white-space: nowrap;
}

.tools .label.gap
{
    margin-left: 22dp;
}

.set-name
{
    color: #ffffff;
    white-space: nowrap;
}

.tools .choice.set
{
    flex: 0 1 auto;
    max-width: 40%;
}

#filter, .filter
{
    display: block;
    width: 30%;
    padding: 4dp 8dp;
    background-color: #ffffff12;
    border: 1dp #ffffff30;
    color: #ffffff;
}

#filter:focus, .filter:focus
{
    border-color: #c4a480;
}

.filter
{
    flex: 1 1 0dp;
    width: auto;
}

.toggle
{
    display: block;
    margin-left: 14dp;
    padding: 4dp 12dp;
    color: #9a9a9a;
    border: 1dp #ffffff30;
    white-space: nowrap;
}

.toggle.on
{
    color: #ffffff;
    background-color: #c4a48033;
}

.toggle:focus, .toggle:hover
{
    border-color: #c4a480;
}

/* A list's head and its rows: flex rows of cells, the same widths; the
   head as wide as a row beside the list's scroll bar, its cells as far in
   as a row's (its border and padding). */
.table-head
{
    position: absolute;
    top: 48dp;
    left: 0dp;
    right: 12dp;
    height: 30dp;
    padding-left: 7dp;
    display: flex;
    font-size: 15dp;
}

.table-head .cell
{
    color: #9a9a9a;
    padding: 4dp 0dp;
    border-bottom: 2dp transparent;
}

.table-head button.cell:focus, .table-head button.cell:hover
{
    color: #ffffff;
}

.table-head .cell.sorted
{
    color: #ffffff;
    border-bottom-color: #c4a480;
}

.table-head .cell.sorted.down
{
    border-bottom-color: #7fa8d0;
}

.rows
{
    top: 82dp;
    font-size: 16dp;
}

.row
{
    display: flex;
    padding: 4dp 0dp 4dp 4dp;
}

.row.undrivable
{
    color: #707070;
}

.cell
{
    display: block;
    box-sizing: border-box;
    overflow: hidden;
    white-space: nowrap;
    margin-right: 10dp;
    text-align: left;
}

/* The activities page: the list, the details beside it. */
#activity-left
{
    position: absolute;
    left: 0dp;
    top: 0dp;
    bottom: 0dp;
    width: 37%;
}

#activity-left .table-head { top: 0dp; }
#activity-left .rows { top: 34dp; }

.c-act-name { flex: 3 1 0dp; }
.c-act-difficulty { flex: 1.3 1 0dp; }
.c-act-time { flex: 0.8 1 0dp; }

#activity-details
{
    position: absolute;
    left: 40%;
    right: 0dp;
    top: 0dp;
    bottom: 0dp;
    overflow-y: auto;
    padding-right: 12dp;
}

#activity-details h3
{
    font-size: 24dp;
    color: #ffffff;
    margin-bottom: 6dp;
}

#activity-details h4
{
    font-size: 16dp;
    color: #c4a480;
    margin: 14dp 0dp 6dp 0dp;
    border-bottom: 1dp #c4a48044;
}

.box
{
    padding: 8dp 12dp 2dp 12dp;
    background-color: #ffffff08;
    border: 1dp #ffffff18;
}

.fact-line
{
    color: #d0d0d0;
    margin-bottom: 4dp;
}

.stops
{
    margin: 6dp 0dp 8dp 0dp;
    font-size: 16dp;
}

.stop
{
    display: flex;
    padding: 2dp 0dp;
    color: #c8c8c8;
}

.stop.head
{
    color: #9a9a9a;
    font-size: 15dp;
}

.c-stop-station { flex: 3 1 0dp; }
.c-stop-time { flex: 1 1 0dp; }

/* The timetables page: the table the page's width, the chosen train
   under it. Category, Number and Line only when the set has them. */
.c-name { flex: 3 1 0dp; }
.c-start { flex: 1 1 0dp; }
.c-end { flex: 1 1 0dp; }
.c-from { flex: 2.4 1 0dp; }
.c-to { flex: 2.4 1 0dp; }
.c-category { flex: 1.2 1 0dp; }
.c-number { flex: 1.3 1 0dp; }
.c-line { flex: 1 1 0dp; }
.c-engine { flex: 2.8 1 0dp; }
.c-stops { flex: 0.8 1 0dp; }

#timetable-page .rows
{
    bottom: 124dp;
}

#train-info
{
    position: absolute;
    left: 0dp;
    right: 0dp;
    bottom: 0dp;
    height: 116dp;
    padding: 8dp 12dp;
    box-sizing: border-box;
    background-color: #ffffff08;
    border: 1dp #ffffff18;
    overflow: hidden;
    font-size: 16dp;
}

.info-line
{
    color: #c8c8c8;
    white-space: nowrap;
    overflow: hidden;
    margin-bottom: 3dp;
}

.info-line.strong
{
    color: #ffffff;
    font-size: 18dp;
}

.calls
{
    color: #d0d0d0;
}

/* Each call a box of its own: the line breaks between them. */
.call
{
    display: inline-block;
    margin-right: 16dp;
    white-space: nowrap;
}

.call.pass
{
    color: #707070;
}

/* The explore page: a path and a train side by side, each a list with a
   filter, the chosen one's note under it. */
.half
{
    position: absolute;
    top: 0dp;
    bottom: 0dp;
}

#path-half { left: 0dp; width: 48%; }
#consist-half { left: 52%; right: 0dp; }

.half .rows
{
    bottom: 58dp;
}

.c-path { flex: 1 1 0dp; }
.c-path-name { flex: 1 1 0dp; color: #8c8c8c; }
.c-consist { flex: 1.6 1 0dp; }
.c-consist-engine { flex: 1 1 0dp; }

.list-note
{
    position: absolute;
    left: 0dp;
    right: 0dp;
    bottom: 0dp;
    height: 50dp;
    color: #b0b0b0;
    font-size: 16dp;
    overflow: hidden;
}

/* Exploring on foot with no train: the trains greyed. */
.half.greyed
{
    opacity: 0.4;
}

.half.greyed button, .half.greyed input
{
    tab-index: none;
    nav: none;
    pointer-events: none;
}

/* The bar: two rows of choices, Start at the end. */
#bar
{
    position: absolute;
    left: 2%;
    right: 2%;
    bottom: 18dp;
    height: 104dp;
}

.bar-row
{
    display: flex;
    align-items: center;
    height: 46dp;
    margin-bottom: 8dp;
    white-space: nowrap;
}

/* Each item its own width (RmlUi's flex would shrink a button to
   nothing); the status takes the rest; the station's name is cut when
   long. */
.bar-row button, .bar-row span
{
    flex: 0 0 auto;
}

.bar-row .choice
{
    margin-right: 6dp;
}

.bar-row .choice.wide
{
    flex: 0 1 auto;
    min-width: 160dp;
    max-width: 520dp;
}

.bar-label
{
    color: #9a9a9a;
    margin: 0dp 8dp 0dp 22dp;
}

.bar-label.first
{
    margin-left: 0dp;
}

.bar-value
{
    color: #ffffff;
}

.bar-value.gap
{
    margin-left: 22dp;
}

#mode-drive
{
    margin-left: 0dp;
}

#status
{
    display: block;
    flex: 1 1 0dp;
    min-width: 0dp;
    margin: 0dp 14dp;
    color: #e0a080;
    font-size: 17dp;
    white-space: normal;
    overflow: hidden;
}

#go
{
    display: block;
    font-size: 28dp;
    padding: 6dp 40dp;
    color: #ffffff;
    background-color: #2a5d8f;
    border: 1dp #5599ff66;
}

#go:focus, #go:hover
{
    background-color: #3a74ad;
    border-color: #c4a480;
}

#go.disabled
{
    color: #707070;
    background-color: #ffffff0c;
    border-color: #ffffff20;
}

/* A choice's values, over the right of the window. */
#picker
{
    position: absolute;
    z-index: 10;
    left: 50%;
    right: 2%;
    top: 24dp;
    bottom: 136dp;
    padding: 14dp 16dp;
    background-color: #14171c;
    border: 1dp #c4a480;
}

#picker h3
{
    font-size: 22dp;
    color: #ffffff;
}

#picker .list
{
    top: 54dp;
    bottom: 14dp;
    left: 16dp;
    right: 16dp;
}

/* While it is open, the rest of the window is out of the keys' and the
   mouse's way. */
.picking button, .picking input
{
    tab-index: none;
    nav: none;
    pointer-events: none;
}

.picking #picker button
{
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
    pointer-events: auto;
}

/* The game menu (Esc in a run): in the middle, over the run. */
#game-menu
{
    position: absolute;
    left: 50%;
    top: 34%;
    width: 420dp;
    margin-left: -210dp;
    padding: 26dp 0dp;
    background-color: #0b0d10ee;
    border: 1dp #c4a48066;
    pointer-events: auto;
}

#game-menu button
{
    display: block;
    font-size: 34dp;
    padding: 6dp 0dp 6dp 40dp;
    color: #c8c8c8;
    border-left: 4dp transparent;
}

#game-menu button:focus, #game-menu button:hover
{
    color: #ffffff;
    border-left-color: #c4a480;
    background-color: #ffffff14;
}

/* The loading screen: the route's picture over the whole view, its name. */
body.loading
{
    background-color: #000000;
}

#loading-frame
{
    position: absolute;
    left: 0dp;
    right: 0dp;
    top: 0dp;
    bottom: 0dp;
    text-align: center;
}

/* Its shape kept, the view's height. */
#loading-picture
{
    height: 100%;
}

#loading-name
{
    position: absolute;
    left: 60dp;
    bottom: 84dp;
    font-size: 34dp;
    color: #ffffff;
}

#loading-status
{
    position: absolute;
    left: 60dp;
    bottom: 50dp;
    font-size: 20dp;
    color: #c8c8c8;
}
