<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Test development project</name>
  <Style id="lineRed"><IconStyle><color>ff00ffff</color></IconStyle><LineStyle><color>ff0000ff</color><width>4</width></LineStyle></Style>
  <Style id="lineRedHover"><LineStyle><color>ff0000ff</color><width>6</width></LineStyle></Style>
  <StyleMap id="lineRedMap">
    <Pair><key>normal</key><styleUrl>#lineRed</styleUrl></Pair>
    <Pair><key>highlight</key><styleUrl>#lineRedHover</styleUrl></Pair>
  </StyleMap>
  <Style id="areaBlue"><LineStyle><color>ffff0000</color><width>2</width></LineStyle><PolyStyle><color>40ff0000</color></PolyStyle></Style>
  <Style id="lineGreen"><LineStyle><color>ff00ff00</color><width>3</width></LineStyle></Style>
  <Placemark>
    <name>New stop</name>
    <Point><coordinates>16.2990,50.7730,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Planned line</name>
    <styleUrl>#lineRedMap</styleUrl>
    <LineString>
      <tessellate>1</tessellate>
      <coordinates>
        16.2900,50.7700,0
        16.2980,50.7720,0
        16.3060,50.7760,0
      </coordinates>
    </LineString>
  </Placemark>
  <Placemark>
    <name>Development area</name>
    <styleUrl>#areaBlue</styleUrl>
    <Polygon><outerBoundaryIs><LinearRing><coordinates>
      16.2920,50.7745,0 16.2960,50.7745,0 16.2960,50.7765,0 16.2920,50.7765,0 16.2920,50.7745,0
    </coordinates></LinearRing></outerBoundaryIs></Polygon>
  </Placemark>
  <Placemark>
    <name>Two segments</name>
    <styleUrl>#lineGreen</styleUrl>
    <MultiGeometry>
      <LineString><coordinates>16.3000,50.7690,0 16.3040,50.7700,0</coordinates></LineString>
      <LineString><coordinates>16.3050,50.7705,0 16.3090,50.7715,0</coordinates></LineString>
    </MultiGeometry>
  </Placemark>
</Document>
</kml>
